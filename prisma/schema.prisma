generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id              Int               @id @default(autoincrement())
  name            String
  monthlyQuota    Int               @default(10)
  remainingQuota  Int               @default(10)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  services        Service[]         @relation("ProviderServices")
  assignments     LeadAssignment[]
}

model Service {
  id              Int               @id @default(autoincrement())
  name            String
  providers       Provider[]        @relation("ProviderServices")
  leads           Lead[]
  allocationState AllocationState?
}

model Lead {
  id              Int               @id @default(autoincrement())
  customerName    String
  phoneNumber     String
  city            String
  description     String
  createdAt       DateTime          @default(now())
  
  serviceId       Int
  service         Service           @relation(fields: [serviceId], references: [id])
  
  assignments     LeadAssignment[]

  @@unique([phoneNumber, serviceId]) // Duplicate Lead Prevention
}

model LeadAssignment {
  id              Int               @id @default(autoincrement())
  assignedAt      DateTime          @default(now())

  leadId          Int
  lead            Lead              @relation(fields: [leadId], references: [id])
  
  providerId      Int
  provider        Provider          @relation(fields: [providerId], references: [id])

  @@unique([providerId, leadId]) // Prevent duplicate assignment
}

model AllocationState {
  serviceId                Int      @id
  service                  Service  @relation(fields: [serviceId], references: [id])
  lastAssignedProviderIndex Int     @default(0)
  updatedAt                DateTime @updatedAt
}

model WebhookEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  processedAt DateTime @default(now())
}
